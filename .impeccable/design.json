  "narrative": {
    "northStar": "Monochrome clarity for service in motion",
    "overview": "zakkig uses a white working canvas, decisive black actions, restrained borders, and destructive red. The marketing site adds editorial composition and a QR-paper motif; operational UI prioritizes task clarity.",
    "keyCharacteristics": [
      "White surfaces, black primary actions, quiet gray boundaries, and red destructive states.",
      "Poppins for words; Inter for isolated digits and decimal separators.",
      "Pill actions, 12px fields, 20px cards and popups, and square QR modules.",
      "A shared 4px spacing scale with container-aware work areas and responsive website composition.",
      "Visible shadows only for floating layers and physical QR paper."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Tokens are brand choices. Verify implementation claims in source and accessibility or clarity decisions in the UX research.",
        "section": "overview"
      },
      {
        "name": "The Light Surface Rule",
        "body": "Keep forms, guest content, and dialogs light; reserve dark surfaces for intentional emphasis.",
        "section": "colors"
      },
      {
        "name": "The Semantic Red Rule",
        "body": "Reserve red for errors and destructive actions.",
        "section": "colors"
      },
      {
        "name": "The Split Price Rule",
        "body": "Use webapp Price so isolated digits take Inter while signs and words stay Poppins.",
        "section": "typography"
      },
      {
        "name": "The Available Width Rule",
        "body": "Use container queries inside dashboard work areas and viewport breakpoints for the outer shell and website.",
        "section": "layout"
      },
      {
        "name": "The Tailwind-First Rule",
        "body": "Use Tailwind JSX utilities for expressible styling in both apps; reserve CSS for tokens, fonts, resets, keyframes, and genuine runtime or third-party constraints.",
        "section": "layout"
      },
      {
        "name": "The Boundary Rule",
        "body": "Use borders and tonal fills for ordinary containment; explicit shadows identify floating or physical surfaces.",
        "section": "elevation"
      },
      {
        "name": "The Nested Radius Rule",
        "body": "A 20px popup with 8px padding has 12px inner item corners.",
        "section": "shapes"
      },
      {
        "name": "The Inline Feedback Rule",
        "body": "Place actionable errors by the field or operation and avoid duplicate toasts.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the shared 4px spacing scale, semantic colors, and named control roles.",
      "Do keep the principal action distinct from supporting navigation.",
      "Do preserve input values and visible focus, error, loading, disabled, and selected states.",
      "Do use Tailwind utilities for expressible styling.",
      "Do verify outcome claims against local evidence."
    ],
    "donts": [
      "Do not use dark modals or visible shadows as a general surface style.",
      "Do not treat secondary as a separate gray-filled button role.",
      "Do not apply Inter to words, currency signs, or mixed-text parent containers.",
      "Do not hide required prices, selections, errors, or next steps.",
      "Do not canonize documented implementation deviations."
    ]
