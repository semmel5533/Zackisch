# Convex Configuration
NEXT_PUBLIC_CONVEX_URL="https://<deployment-name>.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://<deployment-name>.convex.site"
CONVEX_DEPLOY_KEY="dev:<deployment-name>|<token>"
CONVEX_DEPLOYMENT="dev:<deployment-name>"

# Base URL for redirects (Password reset, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SMTP Configuration (Google Workspace Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="selim@zakkig.com"
SMTP_PASS="your_google_workspace_app_password"
